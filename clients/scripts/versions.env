# Pinned code-generator toolchain. Every version here is load-bearing:
# generator output is compared byte-for-byte against the committed tree by
# `check-drift.sh --full`, so a floating version would turn that gate into a
# coin flip.
#
# Bumping one of these is a normal change -- bump it, run `generate.sh`, and
# commit the regenerated tree in the same commit.

# Go client. Pure Go, run via `go run <pkg>@<version>`; no Java, no Docker.
OGEN_VERSION=v1.24.0

# Python client. Pure Python, installed into a throwaway venv by generate.sh.
OPENAPI_PYTHON_CLIENT_VERSION=0.26.1

# openapi-python-client shells out to ruff to format what it emits, and
# declares it only as `ruff<0.14,>=0.2`. Formatting is output, so that range
# is not a pin -- ruff 0.14 changes the emitted file (and in fact fails the
# generator outright on UP007). Pin it exactly.
RUFF_VERSION=0.13.3
