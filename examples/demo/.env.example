# Copy to .env — `pnpm start` loads it automatically (node --env-file-if-exists).
# .env is gitignored. Never commit a real dhsk_ value.

# ---- credentials (one keys:create run produces both) ----------------------
# Publishable key. Ships to the browser by design.
CHAT_PUBLISHABLE_KEY=dhpk_test_replace_me

# Secret key. Server-side only — this process is the only thing that sees it.
# Shown once by keys:create and never recoverable.
CHAT_SECRET_KEY=dhsk_test_replace_me

# ---- where chat-service lives --------------------------------------------
# Origin only, no path: @dhaam-ccrm/rest appends /chat-services/api/v1 itself.
CHAT_API_URL=http://localhost:3000

# Full WebSocket URL. Given explicitly, never derived from CHAT_API_URL —
# core refuses to guess a WS host from an HTTP one, and so does this demo.
CHAT_WS_URL=ws://localhost:3000/chat-services/v2/ws

# ---- who this browser is -------------------------------------------------
# The demo mints tokens for this user only. A real integration substitutes
# the identity of whoever is already logged in to your app.
DEMO_USER_ID=demo-user-1
DEMO_USER_NAME=Demo User

# ---- the demo's own port -------------------------------------------------
DEMO_PORT=5173
