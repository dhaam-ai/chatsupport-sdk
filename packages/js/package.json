{
  "name": "@dhaam-ccrm/js",
  "version": "0.1.0",
  "description": "Framework-free bindings for @dhaam-ccrm/core — a tiny imperative store (selector subscriptions with pluggable equality, event subscriptions, core-derived ticks, one-call disposal) over one ChatClient. Zero runtime dependencies, zero DOM. The substrate the embeddable widget is built on.",
  "keywords": [
    "chat",
    "sdk",
    "vanilla",
    "javascript",
    "store",
    "widget"
  ],
  "license": "MIT",
  "author": "Dhaam AI",
  "homepage": "https://github.com/dhaam-ai/chatsupport-sdk/tree/main/packages/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaam-ai/chatsupport-sdk.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/dhaam-ai/chatsupport-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "@dhaam-ccrm/core": "workspace:^"
  },
  "devDependencies": {
    "@dhaam-ccrm/core": "workspace:*",
    "@dhaam-ccrm/binding-conformance": "workspace:*",
    "esbuild": "^0.21.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
