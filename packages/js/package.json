{
  "name": "@dhaam-ccrm/js",
  "version": "0.0.0",
  "description": "Vanilla-JS binding for @dhaam-ccrm/core — adds a browser <script>-tag build (global `ChatSDK`) on top of core's ESM/CJS-only output. No new logic: same createChatClient, packaged for environments without a bundler.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/chat-sdk.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chat",
    "sdk",
    "vanilla-js",
    "browser"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@dhaam-ccrm/core": "workspace:*"
  }
}
