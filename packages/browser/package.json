{
  "name": "@dhaam-ccrm/browser",
  "version": "0.1.0",
  "description": "Framework-free browser primitives for the chat SDK — voice recording, waveform decoding, and viewport read/delivery tracking. No framework, no core dependency, no module-scope side effects.",
  "keywords": [
    "chat",
    "sdk",
    "voice",
    "waveform",
    "read-receipts"
  ],
  "license": "MIT",
  "author": "Dhaam AI",
  "homepage": "https://github.com/dhaam-ai/chatsupport-sdk/tree/main/packages/browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaam-ai/chatsupport-sdk.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/dhaam-ai/chatsupport-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
