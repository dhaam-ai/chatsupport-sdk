{
  "name": "@dhaam-ccrm/core",
  "version": "0.0.0",
  "description": "Framework-agnostic chat SDK core — transport, auth, observable state, offline queue. Zero UI dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chat",
    "sdk",
    "websocket",
    "framework-agnostic"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
