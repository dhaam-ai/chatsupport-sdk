{
  "name": "@dhaam-ccrm/binding-conformance",
  "version": "0.0.0",
  "description": "Shared conformance suite every @dhaam-ccrm framework binding (react/vue/angular/vanilla) runs against itself — the anti-divergence mechanism for PRD §15's \"reviewably thin, behaves identically\" requirement. Not a set of React tests: framework-agnostic, driven by a small adapter each binding implements.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "chat",
    "sdk",
    "conformance",
    "test-suite"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dhaam-ccrm/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^2.1.0"
  },
  "devDependencies": {
    "@dhaam-ccrm/react": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
