{
  "name": "@dhaam-ccrm/binding-conformance",
  "version": "0.1.0",
  "description": "Shared conformance suite every @dhaam-ccrm framework binding (react/vue/angular/vanilla) runs against itself — the anti-divergence mechanism for PRD §15's \"reviewably thin, behaves identically\" requirement. Not a set of React tests: framework-agnostic, driven by a small adapter each binding implements.",
  "keywords": [
    "chat",
    "sdk",
    "conformance",
    "test-suite"
  ],
  "license": "MIT",
  "author": "Dhaam AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaam-ai/chatsupport-sdk.git",
    "directory": "packages/binding-conformance"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@dhaam-ccrm/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^2.1.0"
  },
  "devDependencies": {
    "@dhaam-ccrm/react": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "private": true
}
