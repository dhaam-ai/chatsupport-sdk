<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for the chat socket and every REST call.

         `flutter create` puts INTERNET only in src/debug and src/profile,
         where the Flutter tool needs it for hot reload — NOT in main. So a
         release build of a host app that never adds this line here debugs
         perfectly and then cannot connect at all once shipped. It is
         declared by the app, not by the SDK: `file_picker` 11.0.3, the only
         plugin this package pulls in, declares no <uses-permission> of its
         own (its manifest carries a <queries> block and nothing else), and
         neither does any other dependency here. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The composer's voice note button. Unlike file_picker, `record` 6.2.1
         DOES declare this in record_android's own manifest, so it would be
         merged in whether or not this line existed — it is written out here
         anyway because a permission a host's users are asked for at runtime
         should be visible in the host's own manifest rather than arriving
         invisibly through a transitive dependency, and because this is the
         file a reviewer looks at when asking why the app wants a microphone.

         Android 6+ also asks at runtime, which `record`'s
         `hasPermission(request: true)` is what triggers — see
         `RecordVoiceDevice.requestPermission`, and note that the platform
         answers a bare boolean, so a dismissed prompt and a permanent
         refusal are reported the same way and this SDK deliberately takes
         the safer reading. https://pub.dev/packages/record#android -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="dhaam_chat_flutter_example"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
