          "next": "finish"
        }
      },
      "finish": {
        "id": "finish",
        "kind": "end",
        "name": "Finish",
        "text": "Anything else? Just type it here.",
        "next": {}
      },
      "toTeam": {
        "id": "toTeam",
        "kind": "handoff",
        "name": "Hand to the team",
        "teamId": null,
        "teamName": "",
        "text": "Connecting you with our team.",
        "next": {}
      }
    }
  }
