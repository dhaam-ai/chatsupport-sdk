    "steps": {
      "ask": {
        "id": "ask",
        "kind": "buttons",
        "name": "Ask what they need",
        "text": "Ordering from this store? How can we help?",
        "buttons": [
          {
            "id": "menu",
            "label": "Menu and prices"
          },
          {
            "id": "hours",
            "label": "Opening hours"
          },
          {
            "id": "area",
            "label": "Delivery to my area"
          },
          {
            "id": "person",
            "label": "Chat with a person"
          }
        ],
        "next": {
          "menu": "menuMsg",
          "hours": "hoursMsg",
          "area": "areaMsg",
          "person": "toTeam",
          "typed": "toTeam"
        }
      },
      "menuMsg": {
        "id": "menuMsg",
        "kind": "message",
        "name": "Explain the menu",
        "text": "Prices are on each item and include taxes. Any delivery fee is shown before you pay.",
        "next": {
          "next": "finish"
        }
      },
      "hoursMsg": {
        "id": "hoursMsg",
        "kind": "message",
        "name": "Explain the hours",
